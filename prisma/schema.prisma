generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model Subscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  status           SubscriberStatus @default(PENDING)
  confirmToken     String           @unique
  unsubscribeToken String           @unique
  createdAt        DateTime         @default(now())
  confirmedAt      DateTime?
}

// ponytail: per-IP rate limit via row count, add Redis if traffic grows
model RateLimitHit {
  id        String   @id @default(cuid())
  ip        String
  route     String
  createdAt DateTime @default(now())

  @@index([ip, route, createdAt])
}
